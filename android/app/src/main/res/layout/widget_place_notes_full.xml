<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/plugin_ic_place_notes" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Place Notes"
                android:textColor="#E8EDF7"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/places_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 places"
                android:textColor="#8B95A8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- In-widget toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/places_btn_monitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:text="Monitor off"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/places_btn_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_chip"
            android:text="Pin here"
            android:textColor="#22D3EE"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/places_btn_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_btn_circle"
            android:contentDescription="Refresh distances"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/places_gps_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="GPS · waiting"
        android:textColor="#5C6578"
        android:textSize="11sp" />

    <!-- Interactive place cards -->
    <LinearLayout
        android:id="@+id/places_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/places_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="No place notes yet.\nTap Pin here to drop one at your GPS."
        android:textColor="#8B95A8"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>

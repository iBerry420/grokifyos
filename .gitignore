.env
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/bridge-runtime/*
!/storage/bridge-runtime/.gitkeep
/storage/apk/*
!/storage/apk/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/grok-auth.json
/storage/discord-jwt.json
/bridge/node_modules/
/android/.gradle/
/android/**/build/
/android/local.properties
*.apk
*.log
.DS_Store

# User/runtime uploads (chat media)
/uploads/*
!/uploads/.gitkeep

# Optional local Mapbox override (never commit real tokens)
**/mapbox_access_token.local.xml

# Git worktrees (local isolation)
.worktrees/

# Godot editor cache (regenerated locally)
godot/**/.godot/

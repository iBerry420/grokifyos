# GrokifyOS Apache vhost (HTTP → ACME + redirect; TLS via certbot --apache)
# Replace ServerName, paths, and email. Symlink install root → /var/www/grokifyos

<VirtualHost *:80>
    ServerName your.domain.example
    ServerAdmin admin@your.domain.example

    DocumentRoot /var/www/grokifyos/web/public

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://your.domain.example%{REQUEST_URI} [R=301,L,NE]

    Alias /api /var/www/grokifyos/web/api
    Alias /assets /var/www/grokifyos/web/assets
    Alias /uploads /var/www/grokifyos/uploads

    Alias /.well-known/acme-challenge /var/www/html/.well-known/acme-challenge
    <Directory /var/www/html/.well-known/acme-challenge>
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    <Directory /var/www/grokifyos/web/public>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
        <FilesMatch \.php$>
            SetHandler application/x-httpd-php
        </FilesMatch>
    </Directory>
    <Directory /var/www/grokifyos/web/api>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
        <FilesMatch \.php$>
            SetHandler application/x-httpd-php
        </FilesMatch>
        <IfModule mod_rewrite.c>
            RewriteEngine On
            RewriteCond %{HTTP:Authorization} .
            RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
        </IfModule>
    </Directory>
    <Directory /var/www/grokifyos/web/assets>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>
    <Directory /var/www/grokifyos/uploads>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    # Deny sensitive trees if ever exposed via misconfiguration
    <Directory /var/www/grokifyos/web/includes>
        Require all denied
    </Directory>
    <Directory /var/www/grokifyos/schema>
        Require all denied
    </Directory>
    <Directory /var/www/grokifyos/scripts>
        Require all denied
    </Directory>
    <Directory /var/www/grokifyos/storage>
        Require all denied
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/your.domain.example_error.log
    # Do not write MCP tokens (path secret) to combined. REPLACES the
    # unconditional CustomLog … combined line — do not leave both.
    LogFormat "%h %l %u %t \"MCP /mcp/[redacted] %H\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" lyre_mcp_redacted
    SetEnvIf Request_URI "^/mcp" lyre_mcp_req
    CustomLog ${APACHE_LOG_DIR}/your.domain.example_access.log lyre_mcp_redacted env=lyre_mcp_req
    CustomLog ${APACHE_LOG_DIR}/your.domain.example_access.log combined env=!lyre_mcp_req
</VirtualHost>

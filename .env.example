# GrokifyOS environment (copy to .env and fill in)
# See docs/INSTALL.md for Ubuntu / Windows / macOS setup.

GROKIFY_APP_NAME=GrokifyOS
# Local: http://127.0.0.1:8787  |  VPS: https://your.domain
GROKIFY_SITE_URL=http://127.0.0.1:8787
GROKIFY_WEB_BASE=

# MySQL — dedicated database
GROKIFY_DB_HOST=127.0.0.1
GROKIFY_DB_PORT=3306
GROKIFY_DB_NAME=grokifyos
GROKIFY_DB_USER=grokifyos
GROKIFY_DB_PASS=change-me

# Agent bridge (HTTP health + models; Node process)
GROKIFY_BRIDGE_URL=http://127.0.0.1:8876
GROKIFY_BRIDGE_HEALTH=http://127.0.0.1:8876/health
# Public WebSocket path (reverse proxy → bridge)
GROKIFY_WS_PATH=/grokify-ws/
# Shared secrets (openssl rand -hex 32)
GROKIFY_WS_AUTH_SECRET=
GROKIFY_SECRETS_PEPPER=

# Grok Build OAuth auth.json (from `grok login`) — real usage only
# GROKIFY_GROK_AUTH_JSON=/path/to/auth.json
# GROKIFY_GROK_BILLING_URL=https://cli-chat-proxy.grok.com/v1/billing?format=credits

# gbotd (headless Grok Bot). Phone inner app "Grok Bot" proxies through /api/gbot.php.
# Enable loopback HTTP: gbotd install --tcp  (or GBOTD_HTTP=1 + token file).
# GROKIFY_GBOTD_URL=http://127.0.0.1:8780
# GROKIFY_GBOTD_TOKEN=
# GROKIFY_GBOTD_SOCK=/run/gbotd/gbotd.sock

# Avalynn Discord backend (phone inner app "Discord"). PHP proxies /api/discord.php to loopback.
# Password is read from Avalynn settings (discord_backend_password) unless overridden.
# GROKIFY_DISCORD_URL=http://127.0.0.1:4201
# GROKIFY_DISCORD_AVALYNN_USER_ID=1
# GROKIFY_AVALYNN_ENV=/var/www/avalynn/.env
# GROKIFY_DISCORD_PASSWORD=
# GROKIFY_DISCORD_AVATAR_DIR=/var/www/avalynn/uploads/audit-avatars
# GROKIFY_DISCORD_FILES_DIR=/var/www/avalynn/uploads/discord-files

# LYRE (phone inner app). Server-side only — never ship these to the APK.
# GROKIFY_LYRE_DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require
# GROKIFY_LYRE_ME_API_KEY=gme_
# GROKIFY_LYRE_ME_API_BASE=https://me.grokpot.io/v1
# GROKIFY_LYRE_ME_STORAGE_BASE=https://me.grokpot.io/v1/storage
# GROKIFY_LYRE_ODYSSEUS_BOARD_ID=lyre

